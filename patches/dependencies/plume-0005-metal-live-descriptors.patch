+    void MetalDescriptorSet::setResourceEntry(uint32_t descriptorIndex, MTL::Resource *resource, RenderDescriptorRangeType type) {
+        // Called under descriptorMutex. A compact bitmap keeps updates O(1)
+        // and preserves descriptor order without scanning every empty entry.
+        const uint64_t mask = uint64_t(1) << (descriptorIndex % 64);
+        uint64_t &word = activeResourceWords[descriptorIndex / 64];
+        const bool wasActive = (word & mask) != 0;
+        if (resource != nullptr) {
+            word |= mask;
+            activeResourceCount += !wasActive;
+        }
+        else {
+            word &= ~mask;
+            activeResourceCount -= wasActive;
+        }
+        resourceEntries[descriptorIndex].resource = resource;
+        resourceEntries[descriptorIndex].type = type;
     }
 
