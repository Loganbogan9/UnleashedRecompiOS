diff --git a/plume_metal_diagnostics.h b/plume_metal_diagnostics.h
new file mode 100644
--- /dev/null
+++ b/plume_metal_diagnostics.h
@@ -0,0 +1,8 @@
+// Metal diagnostics can be routed to the application's persistent log.
+#pragma once
+
+namespace plume {
+    using MetalDiagnosticCallback = void (*)(const char *message, bool error);
+    // The callback can run on a Metal driver thread and must be thread-safe.
+    void setMetalDiagnosticCallback(MetalDiagnosticCallback callback);
+}
