+    static std::atomic<MetalDiagnosticCallback> metalDiagnosticCallback{nullptr};
+
+    void setMetalDiagnosticCallback(MetalDiagnosticCallback callback) {
+        metalDiagnosticCallback.store(callback);
+    }
+
+    static void reportMetalDiagnostic(const char *message, bool error) {
+        if (auto callback = metalDiagnosticCallback.load()) {
+            callback(message, error);
+        } else {
+            fprintf(stderr, "%s\n", message);
+        }
+    }
+
+    static void reportMetalCommandBufferError(MTL::CommandBuffer *buffer) {
+        if (buffer->status() != MTL::CommandBufferStatusError) {
+            return;
+        }
+        static std::atomic<uint32_t> errorCount{0};
+        if (errorCount.fetch_add(1) >= 16) {
+            return;
+        }
+        MetalAutoreleasePool releasePool;
+        const NS::Error *error = buffer->error();
+        const NS::String *label = buffer->label();
+        const NS::String *description = error ? error->localizedDescription() : nullptr;
+        char message[768];
+        snprintf(message, sizeof(message), "Metal command buffer failed: label=%s, code=%lld, description=%s",
+            label ? label->utf8String() : "<unlabeled>",
+            error ? static_cast<long long>(error->code()) : 0,
+            description ? description->utf8String() : "<unavailable>");
+        reportMetalDiagnostic(message, true);
+    }
