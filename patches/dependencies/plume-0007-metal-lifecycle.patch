+    // Serialize deactivation with every native commit, including copy/acquire/
+    // wait/present buffers. Never wait for guest work from UIKit's main thread.
+#if TARGET_OS_IPHONE
+    struct MetalSubmissionState {
+        std::mutex mutex;
+        std::condition_variable changed;
+        bool active = true;
+        std::unordered_map<MTL::CommandQueue *, NS::SharedPtr<MTL::CommandBuffer>> lastSubmitted;
+    };
+
+    static MetalSubmissionState &metalSubmissionState() {
+        static MetalSubmissionState state;
+        return state;
+    }
+#endif
+
+    static void waitForMetalAppActive() {
+#if TARGET_OS_IPHONE
+        auto &state = metalSubmissionState();
+        std::unique_lock lock(state.mutex);
+        state.changed.wait(lock, [&state] { return state.active; });
+#endif
+    }
+
+    static void commitMetalCommandBuffer(MTL::CommandBuffer *buffer) {
+#if TARGET_OS_IPHONE
+        auto &state = metalSubmissionState();
+        std::unique_lock lock(state.mutex);
+        state.changed.wait(lock, [&state] { return state.active; });
+#endif
+        // Reserve queue order only when we can also commit. An enqueued,
+        // uncommitted buffer ahead of a committed one could prevent the latter
+        // from being scheduled while the app's submission gate is closed.
+        buffer->enqueue();
+        buffer->commit();
+#if TARGET_OS_IPHONE
+        state.lastSubmitted[buffer->commandQueue()] = NS::RetainPtr(buffer);
+#endif
+    }
+
+    void setMetalAppActive(bool active) {
+#if TARGET_OS_IPHONE
+        MetalAutoreleasePool releasePool;
+        auto &state = metalSubmissionState();
+        std::unique_lock lock(state.mutex);
+        state.active = active;
+        if (!active) {
+            // Apple requires pending work on EVERY queue to be scheduled before
+            // applicationDidEnterBackground returns. This does not wait for
+            // completion or for any guest/UI callback to submit another frame.
+            for (auto &[queue, buffer] : state.lastSubmitted) {
+                buffer->waitUntilScheduled();
+            }
+            state.lastSubmitted.clear();
+        }
+        lock.unlock();
+        if (active) {
+            state.changed.notify_all();
+        }
+#endif
+    }
+
