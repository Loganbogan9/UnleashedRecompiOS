diff --git a/plume_metal_lifecycle.h b/plume_metal_lifecycle.h
new file mode 100644
--- /dev/null
+++ b/plume_metal_lifecycle.h
@@ -0,0 +1,8 @@
+// Called on the UIKit main thread to stop/resume iOS GPU submissions.
+#pragma once
+
+namespace plume {
+    // Deactivation blocks future commits and schedules prior buffers on all
+    // queues before returning. Worker submissions wait until reactivation.
+    void setMetalAppActive(bool active);
+}
